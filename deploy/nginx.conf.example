server {
    listen 80;
    listen [::]:80;
    server_name news.readcine.com;

    root /var/www/movie-awards-site;
    index index.html;

    # 影片别名。静态导出写不出 HTTP 状态，由这里 301。
    # 精确匹配优先于 location / 的尾斜杠规则，一次跳到 https 规范页，不经过 http。
    location = /film/nowhere-to-lay-my-eyes { return 301 https://$host/film/nowhere-to-lay-eyes; }
    location = /film/nowhere-to-lay-my-eyes/ { return 301 https://$host/film/nowhere-to-lay-eyes; }
    location = /en/film/nowhere-to-lay-my-eyes { return 301 https://$host/en/film/nowhere-to-lay-eyes; }
    location = /en/film/nowhere-to-lay-my-eyes/ { return 301 https://$host/en/film/nowhere-to-lay-eyes; }
    location = /film/la-bola-negra { return 301 https://$host/film/the-black-ball; }
    location = /film/la-bola-negra/ { return 301 https://$host/film/the-black-ball; }
    location = /en/film/la-bola-negra { return 301 https://$host/en/film/the-black-ball; }
    location = /en/film/la-bola-negra/ { return 301 https://$host/en/film/the-black-ball; }
    location = /film/movie-douban-36808876 { return 301 https://$host/film/the-odyssey; }
    location = /film/movie-douban-36808876/ { return 301 https://$host/film/the-odyssey; }
    location = /en/film/movie-douban-36808876 { return 301 https://$host/en/film/the-odyssey; }
    location = /en/film/movie-douban-36808876/ { return 301 https://$host/en/film/the-odyssey; }
    location = /film/other-mommy { return 301 https://$host/film/movie-douban-37317907; }
    location = /film/other-mommy/ { return 301 https://$host/film/movie-douban-37317907; }
    location = /en/film/other-mommy { return 301 https://$host/en/film/movie-douban-37317907; }
    location = /en/film/other-mommy/ { return 301 https://$host/en/film/movie-douban-37317907; }

    location / {
        # Next.js static export emits path.html (no trailingSlash):
        # /film/id/ -> /film/id, unknown paths -> site 404 page (not nginx default).
        # 尾斜杠直接 301 到 https（不要先落到 http:// 再跳一次）。
        # HSTS 只在 https 响应上才有效，别加在 80 端口这层——由 443/反代层下发。
        rewrite ^/(.+)/$ https://$host/$1 permanent;
        try_files $uri $uri.html $uri/ =404;
        add_header Cache-Control "public, max-age=300";
    }

    error_page 404 /404.html;

    location /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
}
